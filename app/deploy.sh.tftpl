#!/bin/bash
# Generated by Terraform: installs the demo app on the VM. Executed via az vm run-command.
set -euo pipefail

cloud-init status --wait >/dev/null 2>&1 || true

APP=/opt/tableflow-demo/app
ETC=/etc/tableflow-demo
install -d -o demo -g demo "$APP"
install -d -m 750 -o root -g demo "$ETC"

%{ for name, content in files ~}
echo '${content}' | base64 -d > "$APP/${name}"
%{ endfor ~}
chown -R demo:demo "$APP"

# Convenience wrapper: /opt/tableflow-demo/run <script.py> [args]
cat > /opt/tableflow-demo/run <<'RUNEOF'
#!/bin/bash
set -a; . /etc/tableflow-demo/common.env; [ -r /etc/tableflow-demo/snowflake.env ] && . /etc/tableflow-demo/snowflake.env; set +a
cd /opt/tableflow-demo/app && exec /opt/tableflow-demo/venv/bin/python "$@"
RUNEOF
chmod 755 /opt/tableflow-demo/run

cat > "$ETC/common.env" <<'ENVEOF'
%{ for k, v in common_env ~}
${k}=${v}
%{ endfor ~}
ENVEOF
chown root:demo "$ETC/common.env"
chmod 640 "$ETC/common.env"

# topics.txt is the producer's live topic list; keep topics added during a demo.
touch "$ETC/topics.txt"
%{ for t in topics ~}
grep -qxF '${t}' "$ETC/topics.txt" || echo '${t}' >> "$ETC/topics.txt"
%{ endfor ~}
chown demo:demo "$ETC/topics.txt"

sudo -u demo /opt/tableflow-demo/venv/bin/pip install --quiet --upgrade pip
sudo -u demo /opt/tableflow-demo/venv/bin/pip install --quiet -r "$APP/requirements.txt"

cp "$APP"/tableflow-*.service "$APP"/tableflow-*.timer /etc/systemd/system/
systemctl daemon-reload

# Create topics + register schemas over Private Link before Tableflow is enabled.
sudo -u demo bash -c "set -a; . $ETC/common.env; set +a; /opt/tableflow-demo/venv/bin/python $APP/create_topics.py"

systemctl enable tableflow-producer.service
systemctl restart tableflow-producer.service
systemctl enable --now tableflow-sync.timer

sleep 5
systemctl is-active tableflow-producer.service
echo DEPLOY_OK
