#!/bin/bash
# Generated by Terraform: installs the demo app on the VM. Executed via az vm run-command.
set -euo pipefail

cloud-init status --wait >/dev/null 2>&1 || true

APP=/opt/tableflow-demo/app
ETC=/etc/tableflow-demo
install -d -o demo -g demo "$APP"
install -d -m 750 -o root -g demo "$ETC"

%{ for name, content in files ~}
echo '${content}' | base64 -d > "$APP/${name}"
%{ endfor ~}
chown -R demo:demo "$APP"

# Convenience wrapper: /opt/tableflow-demo/run <script.py> [args]
cat > /opt/tableflow-demo/run <<'RUNEOF'
#!/bin/bash
set -a; . /etc/tableflow-demo/common.env; [ -r /etc/tableflow-demo/snowflake.env ] && . /etc/tableflow-demo/snowflake.env; set +a
cd /opt/tableflow-demo/app && exec /opt/tableflow-demo/venv/bin/python "$@"
RUNEOF
chmod 755 /opt/tableflow-demo/run

cat > "$ETC/common.env" <<'ENVEOF'
%{ for k, v in common_env ~}
${k}=${v}
%{ endfor ~}
ENVEOF
chown root:demo "$ETC/common.env"
chmod 640 "$ETC/common.env"

# topics.txt is the producer's live topic list; keep topics added during a demo.
touch "$ETC/topics.txt"
%{ for t in topics ~}
grep -qxF '${t}' "$ETC/topics.txt" || echo '${t}' >> "$ETC/topics.txt"
%{ endfor ~}
chown demo:demo "$ETC/topics.txt"

sudo -u demo /opt/tableflow-demo/venv/bin/pip install --quiet --upgrade pip
sudo -u demo /opt/tableflow-demo/venv/bin/pip install --quiet -r "$APP/requirements.txt"

cp "$APP"/tableflow-*.service "$APP"/tableflow-*.timer /etc/systemd/system/
systemctl daemon-reload

# Create topics + register schemas over Private Link before Tableflow is enabled.
sudo -u demo bash -c "set -a; . $ETC/common.env; set +a; /opt/tableflow-demo/venv/bin/python $APP/create_topics.py"

# Bare topic (no schema) for the fully-managed Datagen ORDERS connector, which
# brings its own schema and does not auto-create its topic on Confluent Cloud.
sudo -u demo bash -c "set -a; . $ETC/common.env; set +a; /opt/tableflow-demo/venv/bin/python $APP/create_bare_topic.py ${orders_topic}"

systemctl enable tableflow-producer.service
systemctl restart tableflow-producer.service
systemctl enable --now tableflow-sync.timer

# ---------------------------------------------------------------------------
# Monitoring: Prometheus + Grafana + node_exporter, all bound to 127.0.0.1 and
# reached over an SSH tunnel. Docker is installed here rather than in
# cloud-init because changing custom_data would force the VM to be replaced.
# ---------------------------------------------------------------------------
MON=/opt/tableflow-demo/monitoring
install -d "$MON"

%{ for name, content in monitoring_files ~}
install -d "$(dirname "$MON/${name}")"
echo '${content}' | base64 -d > "$MON/${name}"
%{ endfor ~}
chmod -R a+rX "$MON"

# Where sync.py writes the ADLS -> Snowflake metrics for node_exporter.
install -d -o demo -g demo -m 755 /var/lib/tableflow-demo/textfile

cat > "$ETC/monitoring.env" <<'MONEOF'
%{ for k, v in monitoring_env ~}
${k}=${v}
%{ endfor ~}
MONEOF
chmod 600 "$ETC/monitoring.env"

if ! command -v docker >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq docker.io docker-compose-v2 gettext-base
fi
systemctl enable --now docker

set -a; . "$ETC/monitoring.env"; set +a
envsubst '$METRICS_API_KEY $METRICS_API_SECRET $KAFKA_CLUSTER_ID $SCHEMA_REGISTRY_ID' \
  < "$MON/prometheus.yml.tpl" > "$MON/prometheus.yml"
# Holds the Metrics API secret: readable only by the Prometheus container user.
chown 65534:65534 "$MON/prometheus.yml"
chmod 600 "$MON/prometheus.yml"

# docker compose reads GRAFANA_ADMIN_PASSWORD from .env in the project directory.
install -m 600 "$ETC/monitoring.env" "$MON/.env"

docker compose -f "$MON/docker-compose.yaml" up -d --remove-orphans

# prometheus.yml is bind-mounted, so editing it does not change the container
# spec and `compose up -d` leaves the old config loaded. Reload it explicitly.
# Grafana needs no equivalent: its file provisioner re-reads dashboards on a timer.
docker kill -s HUP tableflow-prometheus >/dev/null 2>&1 || \
  docker restart tableflow-prometheus >/dev/null

sleep 5
systemctl is-active tableflow-producer.service
echo DEPLOY_OK
