    {
      "type": "timeseries",
      "title": "Rows in the Iceberg table: ADLS vs what Snowflake can see",
      "description": "Both read from the Iceberg snapshot summary, so neither costs Snowflake warehouse time. The gap is the cost of having no Iceberg REST catalog to federate to on a private-networking cluster.",
      "datasource": {
        "type": "prometheus",
        "uid": "tableflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "tableflow_sync_adls_total_records",
          "legendFormat": "{{topic}} in ADLS",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "tableflow_sync_snowflake_total_records",
          "legendFormat": "{{topic}} in Snowflake",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
