{
  "uid": "tableflow-pipeline",
  "title": "Tableflow pipeline: Kafka to Iceberg to Snowflake (private networking)",
  "description": "Confluent Cloud Metrics API for the Kafka and Tableflow legs, plus sync.py's own metrics for the ADLS to Snowflake leg that no vendor metric covers.",
  "tags": [
    "tableflow",
    "confluent",
    "snowflake",
    "iceberg"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Kafka to Tableflow  (Confluent Cloud Metrics API)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Records per minute: read from Kafka vs committed to Iceberg",
      "description": "'read' is what Tableflow consumed from the topic, 'committed' is what landed in an Iceberg snapshot in ADLS. Tableflow commits every few minutes, so 'committed' arrives in bursts while 'read' stays flat. These are per-minute values straight from the Metrics API, not a rate() over a cumulative counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "tableflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (topic) (confluent_tableflow_rows_read)",
          "legendFormat": "{{topic}} read",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (topic) (confluent_tableflow_rows_added)",
          "legendFormat": "{{topic}} committed",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Materialization latency",
      "description": "Event freshness is the age of the most recently materialized record; processing freshness is how long Tableflow took to handle it. Sawtooths up between commits and drops on each one. Both are Preview metrics in the Confluent Metrics API.\n\nio.confluent.tableflow/kafka_topic_offset and table_offset would give the same picture in records rather than time, but neither is published on this cluster.",
      "datasource": {
        "type": "prometheus",
        "uid": "tableflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "confluent_tableflow_event_freshness_latency_milliseconds",
          "legendFormat": "{{topic}} event",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "confluent_tableflow_processing_freshness_latency_milliseconds",
          "legendFormat": "{{topic}} processing",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Bytes per minute: read from Kafka vs written to Iceberg",
      "description": "Written lands in bursts on each Iceberg commit; read stays roughly flat. The written total is usually lower thanks to Parquet compression.",
      "datasource": {
        "type": "prometheus",
        "uid": "tableflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (topic) (confluent_tableflow_read_bytes)",
          "legendFormat": "{{topic}} read",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (topic) (confluent_tableflow_added_bytes)",
          "legendFormat": "{{topic}} written",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Iceberg snapshots committed per minute",
      "description": "Each snapshot is a new metadata.json in ADLS, which is what sync.py then points Snowflake at. Default commit interval is about 3 minutes, so this reads 0 for a couple of minutes and then 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "tableflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (topic) (confluent_tableflow_snapshots_generated)",
          "legendFormat": "{{topic}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "title": "Rows skipped",
      "description": "Records Tableflow could not process, usually a schema problem. Should stay at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "tableflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tableflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(confluent_tableflow_rows_skipped) or vector(0)",
          "legendFormat": "skipped",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
