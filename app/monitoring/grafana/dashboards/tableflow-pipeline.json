          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Rows committed to ADLS but not yet visible in Snowflake",
      "description": "Measured at the start of each sync run, before it refreshes Snowflake. Returns to zero once sync.py issues ALTER ICEBERG TABLE ... REFRESH.",
