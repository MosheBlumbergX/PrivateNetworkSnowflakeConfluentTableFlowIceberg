# Copy to .env (gitignored) and fill in. Loaded with: set -a; . ./.env; set +a
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# Snowflake identifier is <org>-<account> (SELECT CURRENT_ORGANIZATION_NAME(), CURRENT_ACCOUNT_NAME()),
# not the locator. The account must be on Azure in the same region as infra/ `region`.
SNOWFLAKE_ACCOUNT_NAME=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
